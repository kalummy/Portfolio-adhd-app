{
  "name": "@addi/native-shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && cap sync android",
    "android:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "test": "node --experimental-transform-types --test scripts/*.test.mjs",
    "qa:web": "node scripts/qa-web.mjs",
    "predev": "node scripts/copy-assets.mjs",
    "prebuild": "node scripts/copy-assets.mjs && node scripts/configure-auth.mjs",
    "qa:android": "node scripts/qa-android.mjs",
    "test:auth": "node --experimental-transform-types --test scripts/auth.test.mjs",
    "qa:auth:android": "node scripts/qa-auth-android.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "8.0.2",
    "@capacitor/core": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "^8.0.0",
    "@supabase/supabase-js": "2.112.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
